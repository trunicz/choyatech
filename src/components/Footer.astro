---
const year = new Date().getFullYear();
---

<footer class="bg-white border-t border-gray-100 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <!-- Brand -->
      <div class="col-span-1 md:col-span-1">
        <a
          href="/"
          class="text-2xl font-bold tracking-tighter text-gray-900 mb-4 block"
        >
          choya<span class="text-primary">.tech</span>
        </a>
        <p class="text-gray-500 mb-6 leading-relaxed">
          Transformando la presencia digital de empresas en <strong
            class="text-gray-700">Baja California Sur, México</strong
          > con estrategia, creatividad y tecnología de punta.
        </p>
        <div class="flex space-x-4">
          <!-- Social Icons -->
          <a
            href="https://facebook.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center text-gray-400 hover:bg-[#1877F2] hover:text-white transition-all duration-300"
            aria-label="Facebook"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
              ></path></svg
            >
          </a>
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center text-gray-400 hover:bg-[#E4405F] hover:text-white transition-all duration-300"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.069-4.85.069-3.204 0-3.584-.012-4.849-.069-3.225-.149-4.771-1.664-4.919-4.919-.058-1.265-.069-1.644-.069-4.849 0-3.204.012-3.584.069-4.849.149-3.225 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
              ></path></svg
            >
          </a>
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center text-gray-400 hover:bg-[#0077b5] hover:text-white transition-all duration-300"
            aria-label="LinkedIn"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
              ></path></svg
            >
          </a>
          <a
            href="https://twitter.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center text-gray-400 hover:bg-black hover:text-white transition-all duration-300"
            aria-label="X (Twitter)"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
              ></path></svg
            >
          </a>
        </div>
      </div>

      <!-- Links Column 1 -->
      <div>
        <h3 class="font-bold text-gray-900 mb-4">Servicios</h3>
        <ul class="space-y-3">
          <li>
            <a
              href="/marketing-digital"
              class="text-gray-500 hover:text-primary transition-colors"
              >Marketing Digital</a
            >
          </li>
          <li>
            <a
              href="/seo"
              class="text-gray-500 hover:text-primary transition-colors"
              >SEO y Posicionamiento</a
            >
          </li>
          <li>
            <a
              href="/redes-sociales"
              class="text-gray-500 hover:text-primary transition-colors"
              >Redes Sociales</a
            >
          </li>
          <li>
            <a
              href="/creacion-contenido"
              class="text-gray-500 hover:text-primary transition-colors"
              >Creación de Contenido</a
            >
          </li>
          <li>
            <a
              href="/desarrollo-apps"
              class="text-gray-500 hover:text-primary transition-colors"
              >Desarrollo de Apps</a
            >
          </li>
        </ul>
      </div>

      <!-- Links Column 2 -->
      <div>
        <h3 class="font-bold text-gray-900 mb-4">Compañía</h3>
        <ul class="space-y-3">
          <li>
            <a
              href="/nosotros"
              class="text-gray-500 hover:text-primary transition-colors"
              >Sobre Nosotros</a
            >
          </li>
          <li>
            <a
              href="/casos-exito"
              class="text-gray-500 hover:text-primary transition-colors"
              >Casos de Éxito</a
            >
          </li>
          <li>
            <a
              href="/faq"
              class="text-gray-500 hover:text-primary transition-colors"
              >Preguntas Frecuentes</a
            >
          </li>
          <li>
            <a
              href="/privacidad"
              class="text-gray-500 hover:text-primary transition-colors"
              >Privacidad</a
            >
          </li>
          <li>
            <a
              href="/terminos"
              class="text-gray-500 hover:text-primary transition-colors"
              >Términos</a
            >
          </li>
        </ul>
      </div>

      <!-- Newsletter/Contact -->
      <div class="relative">
        <h3 class="font-bold text-gray-900 mb-4">Mantente informado</h3>
        <p class="text-gray-500 mb-4">
          Suscríbete para recibir noticias y tips de tecnología.
        </p>
        <form id="newsletter-form" class="flex flex-col gap-3">
          <input
            type="hidden"
            name="access_key"
            value={import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ||
              "YOUR_ACCESS_KEY_HERE"}
          />
          <input
            type="hidden"
            name="subject"
            value="Nuevo suscriptor al Newsletter"
          />
          <input type="hidden" name="from_name" value="Newsletter choya.tech" />
          <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display: none;"
          />

          <input
            type="email"
            name="email"
            required
            placeholder="tu@email.com"
            class="px-4 py-2 rounded-lg border border-gray-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none w-full"
          />
          <button
            type="submit"
            id="newsletter-btn"
            class="bg-primary text-white px-4 py-2 rounded-lg font-medium hover:bg-primary-hover transition-colors disabled:opacity-50"
            >Suscribirse</button
          >
          <p id="newsletter-success" class="hidden text-green-600 text-sm mt-2">
            ¡Gracias por suscribirte!
          </p>
          <p id="newsletter-error" class="hidden text-red-500 text-sm mt-2">
            Error. Intenta de nuevo.
          </p>
        </form>
      </div>

      <script>
        const newsForm = document.getElementById(
          "newsletter-form",
        ) as HTMLFormElement;
        const newsBtn = document.getElementById(
          "newsletter-btn",
        ) as HTMLButtonElement;
        const newsSuccess = document.getElementById("newsletter-success");
        const newsError = document.getElementById("newsletter-error");

        if (newsForm) {
          newsForm.addEventListener("submit", async e => {
            e.preventDefault();
            if (newsBtn) {
              newsBtn.disabled = true;
              newsBtn.innerText = "Suscribiendo...";
            }
            if (newsSuccess) newsSuccess.classList.add("hidden");
            if (newsError) newsError.classList.add("hidden");

            const formData = new FormData(newsForm);

            try {
              const response = await fetch("https://api.web3forms.com/submit", {
                method: "POST",
                body: formData,
              });
              const data = await response.json();
              if (data.success) {
                if (newsSuccess) newsSuccess.classList.remove("hidden");
                newsForm.reset();
              } else {
                throw new Error("Error");
              }
            } catch (error) {
              if (newsError) newsError.classList.remove("hidden");
            } finally {
              if (newsBtn) {
                newsBtn.disabled = false;
                newsBtn.innerText = "Suscribirse";
              }
            }
          });
        }
      </script>
    </div>

    <div
      class="border-t border-gray-100 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-400"
    >
      <p>&copy; {year} choya.tech. Todos los derechos reservados.</p>
      <div class="flex gap-6">
        <a href="/privacidad" class="hover:text-gray-600"
          >Política de Privacidad</a
        >
        <a href="/terminos" class="hover:text-gray-600">Términos de Servicio</a>
      </div>
    </div>
  </div>
</footer>
