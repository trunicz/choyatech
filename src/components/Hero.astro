---

---

<section
  id="top"
  class="relative pt-32 pb-20 lg:pt-40 lg:pb-28 overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Text Content -->
      <div class="max-w-2xl">
        <h1
          class="hero-animate text-5xl lg:text-7xl font-bold tracking-tight text-gray-900 leading-[1.1] mb-8"
        >
          Acelera tu <br />
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-violet-600 to-indigo-600"
            >crecimiento</span
          > digital.
        </h1>
        <p
          class="hero-animate text-lg text-gray-600 mb-8 leading-relaxed max-w-lg"
        >
          Únete a la red de empresas que escalan sus ventas con estrategias de
          marketing, SEO y desarrollo de aplicaciones a medida. Automatiza,
          optimiza y crece.
        </p>

        <div class="hero-animate flex flex-col sm:flex-row gap-4 mb-12">
          <a
            href="/#planes"
            class="inline-flex justify-center items-center px-8 py-4 bg-gray-900 text-white font-medium rounded-full hover:bg-black transition-all hover:scale-105 shadow-xl hover:shadow-2xl"
          >
            Ver Planes
          </a>
          <a
            href="/#servicios"
            class="inline-flex justify-center items-center px-8 py-4 bg-white text-gray-900 border border-gray-200 font-medium rounded-full hover:bg-gray-50 transition-all"
          >
            Explorar Servicios
          </a>
        </div>

        <div
          class="hero-animate flex items-center gap-4 text-sm font-medium text-gray-500"
        >
          <div class="flex -space-x-2">
            {
              [1, 2, 3].map(i => (
                <div
                  class={`w-8 h-8 rounded-full border-2 border-white bg-gray-200 flex items-center justify-center overflow-hidden`}
                >
                  <img
                    src={`https://api.dicebear.com/7.x/avataaars/svg?seed=${i}`}
                    alt="User"
                  />
                </div>
              ))
            }
          </div>
          <p>Confían en nosotros +50 empresas</p>
        </div>
      </div>

      <!-- Hero Visual / Bento Grid -->
      <div class="relative lg:h-[600px] w-full hidden lg:block">
        <!-- Decoration blobs -->
        <div
          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] bg-gradient-to-tr from-violet-100/50 to-emerald-50/50 rounded-full blur-3xl -z-10"
        >
        </div>

        <div class="relative w-full h-full grid grid-cols-2 gap-4 p-4">
          <!-- Card 1: Main Image -->
          <div
            class="col-span-1 row-span-2 bg-emerald-300 rounded-[2rem] overflow-hidden relative group"
          >
            <img
              src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&q=80&w=800"
              class="w-full h-full object-cover mix-blend-multiply opacity-90 group-hover:scale-105 transition-transform duration-700"
              alt="Happy client"
            />
            <div
              class="absolute bottom-6 left-6 right-6 bg-white/90 backdrop-blur-sm p-4 rounded-xl"
            >
              <p class="text-sm font-bold text-gray-800">Crecimiento Mensual</p>
              <div class="w-full bg-gray-200 rounded-full h-2 mt-2">
                <div class="bg-emerald-500 h-2 rounded-full w-[85%]"></div>
              </div>
            </div>
          </div>

          <!-- Card 2: Stats -->
          <div
            class="bg-violet-400 rounded-[2rem] p-6 text-white flex flex-col justify-between relative overflow-hidden"
          >
            <div
              class="absolute -right-4 -top-4 w-24 h-24 bg-white/20 rounded-full blur-xl"
            >
            </div>
            <div>
              <p class="text-violet-100 font-medium mb-1">Visitas Web</p>
              <p class="text-4xl font-bold">+14k</p>
            </div>
            <!-- Mini Chart -->
            <div class="flex items-end gap-1 h-16 mt-4">
              <div class="w-full bg-white/30 rounded-t h-[40%]"></div>
              <div class="w-full bg-white/50 rounded-t h-[70%]"></div>
              <div class="w-full bg-white/40 rounded-t h-[50%]"></div>
              <div class="w-full bg-white rounded-t h-[85%]"></div>
              <div class="w-full bg-white/60 rounded-t h-[60%]"></div>
            </div>
          </div>

          <!-- Card 3: Feature Highlight -->
          <div
            class="bg-amber-200 rounded-[2rem] p-6 flex flex-col items-center justify-center text-center relative overflow-hidden"
          >
            <div
              class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10"
            >
            </div>
            <div
              class="w-16 h-16 bg-white rounded-full flex items-center justify-center shadow-lg mb-4 text-amber-500"
            >
              <svg
                class="w-8 h-8"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
              >
            </div>
            <h3 class="text-xl font-bold text-gray-900">SEO Optimizado</h3>
            <p class="text-gray-700 text-sm mt-2">
              Posicionamos tu marca en el #1
            </p>
          </div>

          <!-- Floating connection badge -->
          <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-white rounded-full p-4 shadow-xl z-20 animate-bounce-slow"
          >
            <span class="text-2xl">🚀</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes bounce-slow {
    0%,
    100% {
      transform: translate(-50%, -50%) translateY(-5%);
    }
    50% {
      transform: translate(-50%, -50%) translateY(5%);
    }
  }
  .animate-bounce-slow {
    animation: bounce-slow 4s infinite ease-in-out;
  }
</style>
