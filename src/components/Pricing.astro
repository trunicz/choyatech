              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Right Column (Contact Card) -->
      <div class="lg:col-span-1 h-full">
        <div
          class="bg-[#4F46E5] rounded-3xl p-8 h-full flex flex-col relative overflow-hidden text-center justify-center items-center"
        >
          <!-- Background decoration -->
          <div
            class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full blur-3xl -mr-16 -mt-16"
          >
          </div>
          <div
            class="absolute bottom-0 left-0 w-64 h-64 bg-white/5 rounded-full blur-3xl -ml-16 -mb-16"
          >
          </div>

          <div
