<section id="planes" class="py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2
        class="text-3xl font-bold tracking-tight text-gray-900 sm:text-5xl mb-4"
      >
        Alternativas de precios accesibles
      </h2>
      <p class="text-lg text-gray-500">
        Comienza gratis o mejora tu plan para compartir tu impacto en todas las
        tareas completadas con múltiples personas.
      </p>

      <!-- Toggle -->
      <div class="mt-8 flex justify-center items-center gap-4">
        <span class="text-sm font-bold text-gray-900 uppercase tracking-widest"
          >6 Meses</span
        >
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" id="pricing-toggle" class="sr-only peer" />
          <div
            class="w-14 h-8 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary/20 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-7 after:w-7 after:transition-all peer-checked:bg-primary"
          >
          </div>
        </label>
        <span class="text-sm font-bold text-gray-400 uppercase tracking-widest">
          12 Meses <span
            class="text-primary text-xs bg-blue-50 px-2 py-1 rounded font-bold ml-1"
            >AHORRA 10%</span
          >
        </span>
      </div>
    </div>

    <!-- Main Grid -->
