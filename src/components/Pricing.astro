          <!-- Tag -->
          <div class="absolute top-0 right-0">
            <div
              class="bg-indigo-50 text-[#4F46E5] text-xs font-bold px-4 py-2 rounded-bl-xl border-l border-b border-indigo-100"
            >
              Más Popular
            </div>
          </div>

          <div class="md:w-1/3 text-center md:text-left">
            <div
              class="inline-block px-3 py-1 border border-gray-200 rounded text-xs font-bold text-gray-500 mb-4 uppercase tracking-wider"
            >
              Crecimiento
            </div>
            <div
              class="flex items-baseline justify-center md:justify-start gap-1 mb-6"
