            <div
              class="flex items-baseline justify-center md:justify-start gap-1 mb-6"
            >
              <span
                class="text-5xl font-bold text-gray-900 pricing-value"
                data-base-price="4500">$4,500</span
              >
              <span class="text-gray-400 font-medium">/Mes</span>
            </div>
            <a
              href="/#contacto"
              class="block w-full py-3 px-6 bg-[#4F46E5] text-white font-medium text-center rounded-xl hover:bg-[#4338ca] transition-colors shadow-lg shadow-indigo-200"
            >
              Empezar Ahora
            </a>
          </div>

          <div
            class="md:w-2/3 w-full border-t md:border-t-0 md:border-l border-gray-100 pt-6 md:pt-0 md:pl-8"
          >
            <ul class="space-y-4">
              <li class="flex items-start">
                <svg
                  class="w-5 h-5 text-[#4F46E5] mt-1 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                  ></path></svg
                >
                <span class="ml-3 text-gray-600 font-medium"
                  >Manejo de 2 Redes Sociales</span
