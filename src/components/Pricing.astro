          <h3 class="text-3xl font-bold text-white mb-4 z-10">Contáctanos</h3>
          <p class="text-indigo-100 mb-8 z-10 max-w-xs leading-relaxed">
            Ayuda a tu equipo y organización a planificar mejor las tareas y
            enfocarse en lo que realmente mueve la aguja.
          </p>

          <a
            href="/#contacto"
            class="block w-full py-4 text-[#4F46E5] bg-white font-bold rounded-xl hover:bg-gray-50 transition-colors shadow-lg z-10"
          >
            Contáctanos
          </a>

          <ul class="text-white/80 text-sm mt-6 space-y-2 z-10">
            <li>• Para compras empresariales</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const toggle = document.getElementById("pricing-toggle") as HTMLInputElement;
  const priceElements = document.querySelectorAll(".pricing-value");

  function updatePrices() {
    const isAnnual = toggle.checked; // If checked, it's 12 months (Annual logic)

    priceElements.forEach(el => {
      const basePrice = parseInt(el.getAttribute("data-base-price") || "0");
      let finalPrice = basePrice;

      if (isAnnual) {
        finalPrice = Math.round(basePrice * 0.9);
      }

      // Format as currency
      el.textContent = new Intl.NumberFormat("es-MX", {
        style: "currency",
        currency: "MXN",
        maximumFractionDigits: 0,
      }).format(finalPrice);
    });
  }

  if (toggle) {
    toggle.addEventListener("change", updatePrices);
  }
</script>
