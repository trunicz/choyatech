---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "ChoyaTech: Agencia de Marketing Digital y Páginas Web en Baja California Sur. Expertos en SEO, Desarrollo Web y Apps en La Paz y Los Cabos.",
  image = "/images/og-default.png", // Fallback image (user should create this)
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || "https://choya.tech",
);

// JSON-LD Schema for Local Business / Organization
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "choya.tech",
  alternateName: ["Choya Tech", "ChoyaTech", "Choya Tecnologia"],
  url: "https://choya.tech",
  logo: "https://choya.tech/logo.png",
  image: "https://choya.tech/images/office.jpg",
  description: description,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Centro", // Generic central location for now
    addressCountry: "MX",
    addressRegion: "Baja California Sur",
    addressLocality: "La Paz",
    postalCode: "23000",
  },
  areaServed: [
    "La Paz",
    "Cabo San Lucas",
    "San José del Cabo",
    "Baja California Sur",
    "México",
  ],
  priceRange: "$$",
  telephone: "+52-55-1234-5678",
  sameAs: [
    "https://facebook.com/choyatech",
    "https://instagram.com/choya.tech",
    "https://linkedin.com/company/choyatech",
  ],
});
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO -->
    <title>{title} | choya.tech</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="choyatech, choya tech, choya, paginas web la paz, diseño web bcs, desarrollo apps los cabos, agencia seo baja california sur, marketing digital la paz"
    />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={schema} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-gray-50 text-gray-900 overflow-x-hidden">
    <slot />

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      // Header Animation
      const header = document.querySelector("header");
      if (header) {
        gsap.from(header, {
          y: -100,
          opacity: 0,
          duration: 1,
          ease: "power4.out",
        });
      }

      // Hero content generic animation (if present)
      const heroElements = document.querySelectorAll(".hero-animate");
      if (heroElements.length > 0) {
        gsap.from(heroElements, {
          y: 50,
          opacity: 0,
          duration: 1,
          stagger: 0.2,
          ease: "power3.out",
          delay: 0.5,
        });
      }

      // Sections scroll animation
      const sections = document.querySelectorAll("section");
      sections.forEach(section => {
        gsap.fromTo(
          section.children,
          { y: 50, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 1,
            stagger: 0.1,
            ease: "power3.out",
            scrollTrigger: {
              trigger: section,
              start: "top 80%", // starts when top of section hits 80% down viewport
              toggleActions: "play none none reverse",
            },
          },
        );
      });
    </script>
  </body>
</html>
